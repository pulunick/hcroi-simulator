# 공개판(Headroom) 배포에서만 채운다. 값을 비워 두면 해당 기능이 꺼진다(사내 배포·미리보기·개발 서버).
# 실제 값은 이 파일이 아니라 호스팅 대시보드의 환경변수에만 넣는다 — 저장소는 공개다.

# 배포 대상 어댑터. Cloudflare Pages 는 cloudflare, 사내 Vercel 은 비워 둔다
HCROI_ADAPTER=

# 정식 주소 (예: https://example.com). 이 값이 있어야 검색 색인·사이트맵이 열린다
PUBLIC_SITE_ORIGIN=

# 문의를 받는 메일 주소. 비우면 푸터·개인정보 안내에서 문의 링크가 사라진다
PUBLIC_CONTACT_EMAIL=

# 후원(커피 한 잔) 링크 주소. 비우면 후원 링크가 사라진다
PUBLIC_DONATE_URL=

# Cloudflare Web Analytics 비컨 토큰. 비우면 비컨을 넣지 않는다
PUBLIC_CF_BEACON_TOKEN=

# Umami 사이트 ID. 비우면 스크립트도 이벤트 전송도 하지 않는다
PUBLIC_UMAMI_WEBSITE_ID=

# 구글 서치 콘솔 소유 확인 값
PUBLIC_GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 소유 확인 값
PUBLIC_NAVER_SITE_VERIFICATION=
